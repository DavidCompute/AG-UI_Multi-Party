<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AGUI.Abstractions" Version="0.0.5" />
    <!-- pptx 技能产物要做 OpenXML schema 校验（保证 PowerPoint 能打开），本测试项目需要该 SDK -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- 技能内图表用 ImageSharp 渲染，其字体库为 SixLabors.Fonts；
         本测试项目用它<b>独立</b>校验"图表选中的字体真的含中文字形"（不然只能信技能自报） -->
    <PackageReference Include="SixLabors.Fonts" Version="1.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AguiGroupChat.Hub\AguiGroupChat.Hub.csproj" />
    <ProjectReference Include="..\..\src\AguiGroupChat.Agents\AguiGroupChat.Agents.csproj" />
    <ProjectReference Include="..\..\src\AguiGroupChat.SkillHosting\AguiGroupChat.SkillHosting.csproj" />
    <ProjectReference Include="..\..\src\AguiGroupChat.Web\AguiGroupChat.Web.csproj" />
    <ProjectReference Include="..\..\src\AguiGroupChat.NativeBridge\AguiGroupChat.NativeBridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- sqlite-vec 原生扩展：验证 vec0 按连接加载（LoadExtension("vec0") 按工作目录 / PATH 查找） -->
    <None Include="..\..\src\AguiGroupChat.Desktop\libs\vec0.dll" CopyToOutputDirectory="PreserveNewest" Link="vec0.dll" />
  </ItemGroup>

</Project>
