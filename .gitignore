artifacts/
# 本机桥/其它发布产物（如 dist/nativebridge 自包含单文件 exe，勿入库）
dist/
# 持久化状态文件（运行期生成，勿入库）
data/
# 本地数据库备份（运维脚本临时输出，勿入库）
backup/
# docker compose 环境变量（密钥等，勿入库）
.env
.env.*
!.env.example
# i18n 抽取报告（脚本可随时重新生成）
tools/extract-report.json
# 浏览器自动化截图 / lockfile（运行产物，勿入库）
tools/screenshots/
# 端到端测试脚本的临时状态 / 日志（每次运行重新生成，勿入库）
tools/.e2e_state.json
tools/.e2e_run.log
tools/.wsdebug.txt
tools/.tok.txt
package-lock.json
# node 依赖（如果有，勿入库）
node_modules/
# 本地大模型目录（运行时下载/生成，勿入库，超 GitHub 100MB 限制；*.gguf 已单独忽略）。
# 注意：用精确路径而不是 `**/models/`（在 core.ignorecase=true 的 Windows 上会误伤 C# Models/ 源码目录）。
src/AguiGroupChat.Desktop/models/
# docker compose 侧的 embedding 模型目录（llama.cpp server 的挂载源；*.gguf 已被下面的规则忽略）。
# 用根锚定路径 `/models/*`（而非 `/models/`）才能让 ! 例外生效——git 不允许重新包含被排除目录里的文件。
# 用精确路径而不是 `**/models/`，避免误伤 C# 的 Models/ 源码目录（core.ignorecase=true 的 Windows 上尤其重要）。
/models/*
!/models/README.md
*.gguf
tools/.live.log
tools/.pptxverify.log
# 版面预览产物（逐页 PNG + 渲染文本，用完即弃）
tools/.preview/
# Python 脚本运行产物（导入 tools/ 下的 .py 时会生成，勿入库）
__pycache__/
*.pyc
