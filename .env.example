# ===== AG-UI 群聊扩展协议 Hub 容器化配置 =====
# 复制为 .env 后按需修改：cp .env.example .env（docker compose 自动读取）

# ---- 模型提供方（web 服务）----
# 提供方：mock（开箱即用，无需 Key）/ openai / deepseek
AGENTS_PROVIDER=deepseek
# DeepSeek API Key（也支持 OPENAI_API_KEY）
DEEPSEEK_API_KEY=
# OpenAI 兼容端点（如 http://host.docker.internal:11434/v1），留空用默认
AGENTS_ENDPOINT=
# 默认模型名
AGENTS_MODEL=deepseek-chat
# 是否启用工具调用（默认 true：内置 get_current_time 免审批 + publish_announcement 需审批）
AGENTS_ENABLE_TOOLS=true
# 需审批（人机交互 HITL）的工具名：命中后用 ApprovalRequiredAIFunction 包装，模型调用时运行中断，
# 聊天区弹出 🔐 审批卡片，仅发起请求的用户可批准/拒绝（默认内置 publish_announcement 发布公告）
AGENTS_REQUIRE_APPROVAL_TOOLS=publish_announcement

# ---- 示例数据 ----
# 无历史数据时播种示例群/成员/智能体
SEED_SAMPLE_DATA=true
# 仅协议 Hub 是否播种（默认 false）
SEED_SAMPLE_DATA_HUB=false

# ---- 端口映射 ----
WEB_PORT=5200
HUB_PORT=5100
# 内置 Ollama（语义记忆 embedding）宿主机映射端口；默认 11435（避开本机 Ollama 的 11434）
OLLAMA_PORT=11435
# PostgreSQL 宿主机映射端口（仅本机调试需要；web/hub 容器内走内网 postgres 服务）
PG_PORT=5432

# ---- 存储模式（memory / postgres / mysql / sqlite）----
# postgres（默认）：企业级落盘 + 语义记忆（RAG），本编排已内置 pgvector 版 postgres
# memory：进程内内存 + JSON 快照（无需数据库，此时语义记忆不可用）
STORAGE_PROVIDER=postgres
# 仅协议 Hub 的存储模式（可独立于 web 配置）
STORAGE_PROVIDER_HUB=postgres

# ---- PostgreSQL 连接参数（STORAGE_PROVIDER=postgres 时生效）----
PG_DATABASE=agui
PG_USER=postgres
PG_PASSWORD=agui
# 默认连接串指向本编排的 postgres 服务；也可改为外部实例
# STORAGE_CONNECTION_STRING=Host=postgres;Port=5432;Database=agui;Username=postgres;Password=agui
# ---- 存储模式补充（memory / postgres / mysql / sqlite）----
# 除 compose 内置的 postgres 外，MySQL / SQLite 亦受支持：
#   mysql： 需自备 MySQL 8.0.13+ 实例（如 docker run -d --name agui-mysql -e MYSQL_ROOT_PASSWORD=agui -e MYSQL_DATABASE=agui -p 3306:3306 mysql:8），
#           连接串示例：Server=host.docker.internal;Port=3306;Database=agui;User ID=root;Password=agui
#   sqlite：单文件零部署，连接串示例：Data Source=data/agui.sqlite（容器内写入 /app/data 命名卷）
# STORAGE_CONNECTION_STRING_EXTRA=Server=host.docker.internal;Port=3306;Database=agui;User ID=root;Password=agui

# ---- 语义记忆（RAG，需 STORAGE_PROVIDER=postgres + pgvector）----
# 聊天记录向量化存储，智能体回复前按语义相似度检索注入上下文
# 默认开启：embedding 由内置 ollama 服务提供（首次启动自动拉取 bge-m3 模型，约 1.2GB）
MEMORY_ENABLED=true
# OpenAI 兼容 embedding 端点（compose 内网地址；自备外部 Ollama 可改为 http://host.docker.internal:11434/v1）
MEMORY_EMBEDDING_ENDPOINT=http://ollama:11434/v1
MEMORY_EMBEDDING_MODEL=bge-m3:latest
# 向量维度须与模型一致：bge-m3=1024、MiniLM=384、qwen3-embedding=2560
MEMORY_EMBEDDING_DIMENSIONS=1024
MEMORY_EMBEDDING_TIMEOUT=60
# 内置 ollama 模型常驻内存（避免空闲卸载后首次加载慢；改 5m 可释放内存）
OLLAMA_KEEP_ALIVE=-1
MEMORY_TOP_K=5
MEMORY_MIN_SCORE=0.25
MEMORY_SCOPE=agent
# 个人记忆：每次回复注入的触发者本人历史发言条数（0=关闭）与相似度阈值
MEMORY_PERSONAL_TOP_K=3
MEMORY_PERSONAL_MIN_SCORE=0.25

# ---- 鉴权 ----
# 实时连接 / 写接口强制令牌（默认 true：未登录无法连接 WS/SSE 或调用写接口；
# false 为旧客户端兼容回退，存在任意用户冒充风险，仅限内网调试）
REQUIRE_TOKEN_ON_REALTIME=true
