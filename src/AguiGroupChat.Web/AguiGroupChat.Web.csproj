<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 开发环境密钥存储：dotnet user-secrets set "Agents:ApiKey" "sk-..." -->
    <UserSecretsId>AguiGroupChat-Web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AguiGroupChat.Hub\AguiGroupChat.Hub.csproj" />
    <ProjectReference Include="..\AguiGroupChat.Agents\AguiGroupChat.Agents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sdk.Web 默认把 data/**（运行期数据）与 appsettings*.json 作为 Content 复制到输出并传递给引用方；
         它们应在内容根目录运行时生成 / 读取，不应随产物分发——显式移除，避免污染引用方（如桌面版）输出 -->
    <Content Remove="data\**" />
    <Content Remove="appsettings.json" />
    <Content Remove="appsettings.Development.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- 用户手册：以嵌入资源随程序集分发（前端「📖 完整手册」按语言拉取；避免 dev / Docker / 桌面三处路径差异）。
         相对路径指向仓库 docs/；Dockerfile 发布前需 COPY docs/ docs/，桌面版从仓库构建天然存在。 -->
    <!-- WithCulture="false" 必需：否则 MSBuild 会把文件名里的 .en. 当作 culture（卫星资源），
         从主程序集里剔除，导致英文手册不被嵌入。 -->
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../docs/user-guide.md" LogicalName="AguiGroupChat.Manual.zh.md" WithCulture="false" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../docs/user-guide.en.md" LogicalName="AguiGroupChat.Manual.en.md" WithCulture="false" />
  </ItemGroup>

</Project>
