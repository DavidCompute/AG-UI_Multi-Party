{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "SessionTtlHours": 168,
    "RequireTokenOnRealTime": true
  },
  "Observability": {
    "PrometheusEnabled": true,
    "PrometheusRequireAuth": true,
    "PrometheusScrapeToken": "",
    "ReplicaId": ""
  },
  "LinkProxy": {
    "MaxBytes": 8388608,
    "TimeoutSeconds": 30,
    "AllowPrivate": false
  },
  "Storage": {
    "Provider": "memory",
    "ConnectionString": ""
  },
  "Persistence": {
    "Enabled": true,
    "FilePath": "data/agui-state.json",
    "FlushIntervalSeconds": 5
  },
  "GroupChat": {
    "MessageHistoryLimit": 200,
    "SnapshotMessageCount": 50,
    "MaxGroupMembers": 500,
    "HeartbeatIntervalSeconds": 15,
    "MessageWriteDebounceMs": 1000,
    "SeedSampleData": true
  },
  "Agents": {
    "Provider": "deepseek",
    "ApiKey": "",
    "Endpoint": "",
    "Model": "deepseek-chat",
    "EnableTools": true,
    "EnableWebTools": false,
    "Skills": [],
    "Memory": {
      "RetentionDays": 0
    },
    "Audio": {
      "Enabled": false,
      "Endpoint": "",
      "ApiKey": "",
      "Model": "whisper-1",
      "Language": "zh",
      "MaxBytes": 26214400,
      "TimeoutSeconds": 60,
      "MaxFilesPerMessage": 3
    }
  }
}
