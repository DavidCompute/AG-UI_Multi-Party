{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "SessionTtlHours": 168,
    "RequireTokenOnRealTime": true
  },
  "LinkProxy": {
    "MaxBytes": 8388608,
    "TimeoutSeconds": 30,
    "AllowPrivate": false
  },
  "Storage": {
    "Provider": "memory",
    "ConnectionString": ""
  },
  "Persistence": {
    "Enabled": true,
    "FilePath": "data/agui-state.json",
    "FlushIntervalSeconds": 5
  },
  "GroupChat": {
    "MessageHistoryLimit": 200,
    "SnapshotMessageCount": 50,
    "MaxGroupMembers": 500,
    "HeartbeatIntervalSeconds": 15,
    "MessageWriteDebounceMs": 1000,
    "SeedSampleData": true
  },
  "Agents": {
    "Provider": "deepseek",
    "ApiKey": "",
    "Endpoint": "",
    "Model": "deepseek-chat",
    "EnableTools": true,
    "EnableWebTools": false,
    "Skills": [
      {
        "SkillId": "fetch_translate_webpage",
        "Name": "网页抓取并翻译汇总",
        "Description": "抓取指定网址的网页内容，翻译为中文并输出一份精干摘要（标题、要点、结论）。调用时把目标网址作为请求参数传入（如请求某篇文章的 URL）。需用户批准后执行。",
        "Kind": "Http",
        "Body": "{\"method\":\"GET\",\"url\":\"${query}\",\"headers\":{\"User-Agent\":\"Mozilla/5.0 (AGUI SkillBot)\"}}",
        "RequiresApproval": true,
        "HttpTimeoutSeconds": 30
      },
      {
        "SkillId": "website_digest_prompt",
        "Name": "网页摘要与翻译模板",
        "Description": "把一段网页正文翻译成中文并提炼成结构化摘要（概述、关键点、结论），适用于已有正文需要整理时。请求里给出正文或要点即可。",
        "Kind": "Prompt",
        "Body": "请把下面的网页内容翻译成中文，并输出一份精干的结构化摘要：1) 一句话概述；2) 关键要点（分条）；3) 结论/建议。若内容本身已是中文则只需汇总。\n\n内容：\n<内容>\n",
        "RequiresApproval": false
      }
    ],
    "Memory": {
      "RetentionDays": 0
    }
  }
}
