{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "SessionTtlHours": 168,
    "RequireTokenOnRealTime": true
  },
  "LinkProxy": {
    "MaxBytes": 8388608,
    "TimeoutSeconds": 30,
    "AllowPrivate": false
  },
  "Storage": {
    "Provider": "memory",
    "ConnectionString": ""
  },
  "Persistence": {
    "Enabled": true,
    "FilePath": "data/agui-state.json",
    "FlushIntervalSeconds": 5
  },
  "GroupChat": {
    "MessageHistoryLimit": 200,
    "SnapshotMessageCount": 50,
    "MaxGroupMembers": 500,
    "HeartbeatIntervalSeconds": 15,
    "MessageWriteDebounceMs": 1000,
    "SeedSampleData": true
  },
  "Agents": {
    "Provider": "deepseek",
    "ApiKey": "",
    "Endpoint": "",
    "Model": "deepseek-chat",
    "EnableTools": true,
    "EnableWebTools": false,
    "Skills": [
      {
        "SkillId": "fetch_translate_webpage",
        "Name": "网页抓取并翻译汇总",
        "Description": "抓取指定网址的网页内容，翻译为中文并输出一份精干摘要（标题、要点、结论）。调用时把目标网址作为请求参数传入（如请求某篇文章的 URL）。需用户批准后执行。",
        "Kind": "Http",
        "Body": "{\"method\":\"GET\",\"url\":\"${query}\",\"headers\":{\"User-Agent\":\"Mozilla/5.0 (AGUI SkillBot)\"}}",
        "RequiresApproval": true,
        "HttpTimeoutSeconds": 30
      },
      {
        "SkillId": "website_digest_prompt",
        "Name": "网页摘要与翻译模板",
        "Description": "把一段网页正文翻译成中文并提炼成结构化摘要（概述、关键点、结论），适用于已有正文需要整理时。请求里给出正文或要点即可。",
        "Kind": "Prompt",
        "Body": "请把下面的网页内容翻译成中文，并输出一份精干的结构化摘要：1) 一句话概述；2) 关键要点（分条）；3) 结论/建议。若内容本身已是中文则只需汇总。\n\n内容：\n<内容>\n",
        "RequiresApproval": false
      },
      {
        "SkillId": "ops_system_info",
        "Name": "系统信息",
        "Description": "在本机获取电脑的基本信息（计算机名、当前用户、操作系统名称/版本/架构、上次启动时间、制造商/型号）。用于桌面运维排查。需在本机批准后执行。",
        "Kind": "Shell",
        "Body": "$ProgressPreference='SilentlyContinue';$os=Get-CimInstance Win32_OperatingSystem;$cs=Get-CimInstance Win32_ComputerSystem;@{MachineName=$env:COMPUTERNAME;UserName=$env:USERNAME;OSName=$os.Caption;OSVersion=$os.Version;Arch=$env:PROCESSOR_ARCHITECTURE;LastBoot=$os.LastBootUpTime;Manufacturer=$cs.Manufacturer;Model=$cs.Model}|ConvertTo-Json -Compress",
        "RequiresApproval": true,
        "ExecutionLocation": "Client",
        "ClientRunner": "{\"kind\":\"shell\",\"command\":\"$ProgressPreference='SilentlyContinue';$os=Get-CimInstance Win32_OperatingSystem;$cs=Get-CimInstance Win32_ComputerSystem;@{MachineName=$env:COMPUTERNAME;UserName=$env:USERNAME;OSName=$os.Caption;OSVersion=$os.Version;Arch=$env:PROCESSOR_ARCHITECTURE;LastBoot=$os.LastBootUpTime;Manufacturer=$cs.Manufacturer;Model=$cs.Model}|ConvertTo-Json -Compress\",\"cwd\":\".\",\"timeoutSec\":30}"
      },
      {
        "SkillId": "ops_disk_usage",
        "Name": "磁盘使用情况",
        "Description": "在本机查看各磁盘分区的大小、剩余空间与使用率。用于排查磁盘写满 / 空间不足。需在本机批准后执行。",
        "Kind": "Shell",
        "Body": "$ProgressPreference='SilentlyContinue';Get-CimInstance Win32_LogicalDisk -Filter 'DriveType=3'|ForEach-Object{[PSCustomObject]@{Drive=$_.DeviceID;SizeGB=[math]::Round($_.Size/1GB,1);FreeGB=[math]::Round($_.FreeSpace/1GB,1);UsedPct=if($_.Size){[math]::Round(($_.Size-$_.FreeSpace)/$_.Size*100,1)}else{0}}}|ConvertTo-Json -Compress",
        "RequiresApproval": true,
        "ExecutionLocation": "Client",
        "ClientRunner": "{\"kind\":\"shell\",\"command\":\"$ProgressPreference='SilentlyContinue';Get-CimInstance Win32_LogicalDisk -Filter 'DriveType=3'|ForEach-Object{[PSCustomObject]@{Drive=$_.DeviceID;SizeGB=[math]::Round($_.Size/1GB,1);FreeGB=[math]::Round($_.FreeSpace/1GB,1);UsedPct=if($_.Size){[math]::Round(($_.Size-$_.FreeSpace)/$_.Size*100,1)}else{0}}}|ConvertTo-Json -Compress\",\"cwd\":\".\",\"timeoutSec\":30}"
      },
      {
        "SkillId": "ops_memory_cpu",
        "Name": "内存与 CPU",
        "Description": "在本机查看内存总量 / 已用 / 使用率，以及 CPU 型号与当前负载。用于排查卡顿、内存占用高。需在本机批准后执行。",
        "Kind": "Shell",
        "Body": "$ProgressPreference='SilentlyContinue';$os=Get-CimInstance Win32_OperatingSystem;$cpu=Get-CimInstance Win32_Processor;@{TotalMemGB=[math]::Round($os.TotalVisibleMemorySize/1MB,1);FreeMemGB=[math]::Round($os.FreePhysicalMemory/1MB,1);MemUsedPct=[math]::Round(($os.TotalVisibleMemorySize-$os.FreePhysicalMemory)/$os.TotalVisibleMemorySize*100,1);CpuName=$cpu.Name;CpuLoadPct=($cpu|Measure-Object -Property LoadPercentage -Average).Average}|ConvertTo-Json -Compress",
        "RequiresApproval": true,
        "ExecutionLocation": "Client",
        "ClientRunner": "{\"kind\":\"shell\",\"command\":\"$ProgressPreference='SilentlyContinue';$os=Get-CimInstance Win32_OperatingSystem;$cpu=Get-CimInstance Win32_Processor;@{TotalMemGB=[math]::Round($os.TotalVisibleMemorySize/1MB,1);FreeMemGB=[math]::Round($os.FreePhysicalMemory/1MB,1);MemUsedPct=[math]::Round(($os.TotalVisibleMemorySize-$os.FreePhysicalMemory)/$os.TotalVisibleMemorySize*100,1);CpuName=$cpu.Name;CpuLoadPct=($cpu|Measure-Object -Property LoadPercentage -Average).Average}|ConvertTo-Json -Compress\",\"cwd\":\".\",\"timeoutSec\":30}"
      },
      {
        "SkillId": "ops_top_process",
        "Name": "占用最高进程",
        "Description": "在本机列出内存占用最高的前 15 个进程（名称、PID、CPU、内存）。用于排查哪个程序吃内存 / CPU。需在本机批准后执行。",
        "Kind": "Shell",
        "Body": "Get-Process|Sort-Object WorkingSet64 -Descending|Select-Object -First 15 Name,Id,CPU,@{n='MemMB';e={[math]::Round($_.WorkingSet64/1MB,1)}}|ConvertTo-Json -Compress",
        "RequiresApproval": true,
        "ExecutionLocation": "Client",
        "ClientRunner": "{\"kind\":\"shell\",\"command\":\"Get-Process|Sort-Object WorkingSet64 -Descending|Select-Object -First 15 Name,Id,CPU,@{n='MemMB';e={[math]::Round($_.WorkingSet64/1MB,1)}}|ConvertTo-Json -Compress\",\"cwd\":\".\",\"timeoutSec\":30}"
      },
      {
        "SkillId": "ops_network_conn",
        "Name": "网络连接",
        "Description": "在本机列出前 30 条已建立的 TCP 网络连接（本地/远程地址、端口、所属进程名）。用于排查异常外连、端口占用。需在本机批准后执行。",
        "Kind": "Shell",
        "Body": "Get-NetTCPConnection -State Established|Select-Object -First 30 LocalAddress,LocalPort,RemoteAddress,RemotePort,OwningProcess|ForEach-Object{Add-Member -PassThru -InputObject $_ -NotePropertyName Process -NotePropertyValue (Get-Process -Id $_.OwningProcess -ErrorAction SilentlyContinue).ProcessName}|ConvertTo-Json -Compress -Depth 3",
        "RequiresApproval": true,
        "ExecutionLocation": "Client",
        "ClientRunner": "{\"kind\":\"shell\",\"command\":\"Get-NetTCPConnection -State Established|Select-Object -First 30 LocalAddress,LocalPort,RemoteAddress,RemotePort,OwningProcess|ForEach-Object{Add-Member -PassThru -InputObject $_ -NotePropertyName Process -NotePropertyValue (Get-Process -Id $_.OwningProcess -ErrorAction SilentlyContinue).ProcessName}|ConvertTo-Json -Compress -Depth 3\",\"cwd\":\".\",\"timeoutSec\":30}"
      },
      {
        "SkillId": "ops_services",
        "Name": "服务状态",
        "Description": "在本机列出前 40 个 Windows 服务（状态、名称、显示名）。用于排查服务未启动 / 停止异常。需在本机批准后执行。",
        "Kind": "Shell",
        "Body": "Get-Service|Sort-Object Status -Descending|Select-Object -First 40 Status,Name,DisplayName|ConvertTo-Json -Compress",
        "RequiresApproval": true,
        "ExecutionLocation": "Client",
        "ClientRunner": "{\"kind\":\"shell\",\"command\":\"Get-Service|Sort-Object Status -Descending|Select-Object -First 40 Status,Name,DisplayName|ConvertTo-Json -Compress\",\"cwd\":\".\",\"timeoutSec\":30}"
      },
      {
        "SkillId": "ops_eventlog_error",
        "Name": "最近错误日志",
        "Description": "在本机读取最近 1 天内系统日志中的错误级别事件（最多 10 条），含时间、事件 ID、来源、摘要。用于排查蓝屏 / 报错 / 崩溃。需在本机批准后执行。",
        "Kind": "Shell",
        "Body": "Get-WinEvent -FilterHashtable @{LogName='System';Level=2;StartTime=(Get-Date).AddDays(-1)} -MaxEvents 10 -ErrorAction SilentlyContinue|Select-Object TimeCreated,Id,ProviderName,@{n='Msg';e={if($_.Message.Length -gt 200){$_.Message.Substring(0,200)}else{$_.Message}}}|ConvertTo-Json -Compress -Depth 3",
        "RequiresApproval": true,
        "ExecutionLocation": "Client",
        "ClientRunner": "{\"kind\":\"shell\",\"command\":\"Get-WinEvent -FilterHashtable @{LogName='System';Level=2;StartTime=(Get-Date).AddDays(-1)} -MaxEvents 10 -ErrorAction SilentlyContinue|Select-Object TimeCreated,Id,ProviderName,@{n='Msg';e={if($_.Message.Length -gt 200){$_.Message.Substring(0,200)}else{$_.Message}}}|ConvertTo-Json -Compress -Depth 3\",\"cwd\":\".\",\"timeoutSec\":30}"
      },
      {
        "SkillId": "office_weekly_report",
        "Name": "周报生成",
        "Description": "把本周的工作要点整理成结构化周报（本周完成、进行中、下周计划、风险/求助）。请求里给出本周做的几件要点或不完整思路即可，由模型扩写为专业周报。",
        "Kind": "Prompt",
        "Body": "请把以下本周工作要点整理成一份专业周报，分四节输出：1) 本周完成（按重要性列出，每条一句话带结果）；2) 进行中（说明当前状态与下一步）；3) 下周计划（可执行项）；4) 风险 / 需要支持。语言凝练、用词专业，不要编造要点之外的事实。\n\n本周要点：\n<要点>\n",
        "RequiresApproval": false
      },
      {
        "SkillId": "office_daily_report",
        "Name": "日报生成",
        "Description": "把当天工作内容整理成简洁日报（今日完成、待办/明日计划）。请求里给出当天做了什么即可。",
        "Kind": "Prompt",
        "Body": "请把以下当天工作整理成晨会可用的简明日报：1) 今日完成；2) 今日遇到的问题 / 阻塞；3) 明日计划。每条首行以「- 」开头，控制在 8 行以内，语言简洁。\n\n今日工作：\n<内容>\n",
        "RequiresApproval": false
      },
      {
        "SkillId": "office_email_polish",
        "Description": "把一段草稿邮件润色为正式、得体、简洁的商务邮件（可指定风格：正式 / 礼貌 / 简洁 / 友好）。请求里给出草稿或要点，以及想要的语气。",
        "Kind": "Prompt",
        "Body": "请把下面的邮件草稿润色为得体的商务邮件。要求：1) 语气根据用户指定（默认正式中文商务），不卑不亢；2) 结构清楚（称呼—背景—请求/要点—结尾致谢）；3) 适当精简冗词，保留全部关键信息；4) 不要新增草稿中没有的事实。\n\n草稿：\n<草稿内容>\n\n期望语气：\n<可选语气>\n",
        "RequiresApproval": false
      },
      {
        "SkillId": "office_meeting_minutes",
        "Name": "会议纪要",
        "Description": "把会议记录或录音转写整理成结构化会议纪要（议题、结论/决定、行动项 owner+截止、待跟进）。请求里给出会议内容或讨论要点。",
        "Kind": "Prompt",
        "Body": "请把以下会议内容整理成结构化会议纪要：1) 会议目标 / 议题；2) 关键讨论与结论；3) 行动项（每条含：事项、负责人、截止时间，若原文未给则用「待定」并提示）；4) 未决事项。语言客观、只依据给定内容，不要编造。\n\n会议内容：\n<会议记录>\n",
        "RequiresApproval": false
      },
      {
        "SkillId": "office_presentation_outline",
        "Name": "演示大纲生成",
        "Description": "根据主题和听众生成 PPT / 演示文稿的大纲（开场、章节、结论、每页要点）。请求里给出主题、目的或受众即可。",
        "Kind": "Prompt",
        "Body": "请根据主题生成一份演示文稿大纲，输出为分层清单：开场（破题）→ 2-5 个主章节（每章列出 2-3 个要点页）→ 总结与行动号召。附一句每章节的演讲时长建议。内容要贴合主题、有逻辑递进。\n\n主题：\n<主题>\n\n听众 / 场合：\n<可选>\n",
        "RequiresApproval": false
      },
      {
        "SkillId": "office_okr_draft",
        "Name": "OKR 初稿",
        "Description": "根据目标或季度重点起草一套 OKR（目标 + 3 个左右可量化关键结果）。请求里给方向性描述即可。",
        "Kind": "Prompt",
        "Body": "请根据以下方向起草一套 OKR：1 个目标（O，简洁有挑战）+ 3 个关键结果（KR，尽量可量化、有明确的结果定义）。KR 用「从 X 到 Y」或「达成 Z 的百分比/数量」表达。若信息不足，基于常见最佳实践给出可调整的假设并在末尾注明。\n\n方向 / 季度重点：\n<内容>\n",
        "RequiresApproval": false
      },
      {
        "SkillId": "office_open_my_docs",
        "Name": "打开文档目录",
        "Description": "在本机打开「文档」文件夹（常用办公文件所在目录），方便用户快速进入工作区。需在本机批准后执行。",
        "Kind": "Shell",
        "Body": "$d=[Environment]::GetFolderPath('MyDocuments'); if(Test-Path $d){ Start-Process explorer.exe $d }; Write-Output $d",
        "RequiresApproval": true,
        "ExecutionLocation": "Client",
        "ClientRunner": "{\"kind\":\"shell\",\"command\":\"$d=[Environment]::GetFolderPath('MyDocuments'); if(Test-Path $d){ Start-Process explorer.exe $d }; Write-Output $d\",\"cwd\":\".\",\"timeoutSec\":30}"
      },
      {
        "SkillId": "office_new_notes",
        "Name": "新建记事便签",
        "Description": "在桌面新建一个带时间戳的 txt 便签文件（如 note-yyyyMMddHHmm.txt），便于随手记录。需在本机批准后执行。",
        "Kind": "Shell",
        "Body": "$desk=[Environment]::GetFolderPath('Desktop'); $name='note-'+Get-Date -Format 'yyyyMMddHHmm'+'.txt'; $p=Join-Path $desk $name; New-Item -Path $p -ItemType File -Force|Out-Null; Write-Output $p",
        "RequiresApproval": true,
        "ExecutionLocation": "Client",
        "ClientRunner": "{\"kind\":\"shell\",\"command\":\"$desk=[Environment]::GetFolderPath('Desktop'); $name='note-'+Get-Date -Format 'yyyyMMddHHmm'+'.txt'; $p=Join-Path $desk $name; New-Item -Path $p -ItemType File -Force|Out-Null; Write-Output $p\",\"cwd\":\".\",\"timeoutSec\":30}"
      },
      {
        "SkillId": "office_quick_calc",
        "Name": "打开系统计算器",
        "Description": "在本机启动系统计算器应用，方便即时算术。需在本机批准后执行。",
        "Kind": "Shell",
        "Body": "try{ Start-Process calc.exe; Write-Output 'calc-started' }catch{ Write-Output 'calc-not-found' }",
        "RequiresApproval": true,
        "ExecutionLocation": "Client",
        "ClientRunner": "{\"kind\":\"shell\",\"command\":\"try{ Start-Process calc.exe; Write-Output 'calc-started' }catch{ Write-Output 'calc-not-found' }\",\"cwd\":\".\",\"timeoutSec\":30}"
      },
      {
        "SkillId": "office_work_folder_list",
        "Name": "列出桌面文件",
        "Description": "在本机列出桌面上的常用文件（最近修改的前 20 个），帮用户快速想起 / 找到办公文件。需在本机批准后执行。",
        "Kind": "Shell",
        "Body": "$desk=[Environment]::GetFolderPath('Desktop'); Get-ChildItem $desk -File -ErrorAction SilentlyContinue|Sort-Object LastWriteTime -Descending|Select-Object -First 20 Name,@{n='KB';e={[math]::Round($_.Length/1KB,1)}},LastWriteTime|ConvertTo-Json -Compress",
        "RequiresApproval": true,
        "ExecutionLocation": "Client",
        "ClientRunner": "{\"kind\":\"shell\",\"command\":\"$desk=[Environment]::GetFolderPath('Desktop'); Get-ChildItem $desk -File -ErrorAction SilentlyContinue|Sort-Object LastWriteTime -Descending|Select-Object -First 20 Name,@{n='KB';e={[math]::Round($_.Length/1KB,1)}},LastWriteTime|ConvertTo-Json -Compress\",\"cwd\":\".\",\"timeoutSec\":30}"
      }
    ],
    "Memory": {
      "RetentionDays": 0
    }
  }
}
