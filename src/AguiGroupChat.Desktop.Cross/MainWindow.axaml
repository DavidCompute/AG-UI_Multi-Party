<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.WebView"
        x:Class="AguiGroupChat.Desktop.Cross.MainWindow"
        Title="AG-UI 群聊桌面版"
        Width="1280" Height="860"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,*">

        <!-- 顶部状态栏：本地服务地址 + 便捷操作 -->
        <Border Grid.Row="0" Background="#1F2937" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Content="🌐 浏览器打开" Click="OnOpenBrowser" />
                    <Button x:Name="ReloadBtn" Content="🔄 强制刷新" Click="OnReloadClicked"
                            ToolTip.Tip="带时间戳重新加载，绕开缓存（保留登录状态）" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Foreground="#9CA3AF" FontSize="12"
                           VerticalAlignment="Center" Text="正在启动本地服务…" />
            </DockPanel>
        </Border>

        <!-- WebView：加载本地群聊前端（macOS=WKWebView / Linux=WebKitGTK / Windows=WebView2） -->
        <wv:NativeWebView x:Name="Web" Grid.Row="1" />

    </Grid>
</Window>
