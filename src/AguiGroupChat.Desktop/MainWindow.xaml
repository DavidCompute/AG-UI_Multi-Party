<Window x:Class="AguiGroupChat.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AG-UI 群聊桌面版"
        Height="860" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部状态栏：本地服务地址 + 便捷操作 -->
        <Border Grid.Row="0" Background="#FF1F2937" Padding="10,6">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="StatusText" Foreground="#FF9CA3AF" FontSize="12"
                           VerticalAlignment="Center" Text="正在启动本地服务…" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="HomeBtn" Content="🏠 首页" Margin="4,0" Padding="10,2"
                            Click="OnHomeClicked" />
                    <Button x:Name="ReloadBtn" Content="🔄 强制刷新" Margin="4,0" Padding="10,2"
                            ToolTip="清缓存后重载页面（保留登录状态）；也可用 F5 / Ctrl+R"
                            Click="OnReloadClicked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- WebView2：加载本地群聊前端 -->
        <wv2:WebView2 x:Name="WebView" Grid.Row="1" />
    </Grid>
</Window>
