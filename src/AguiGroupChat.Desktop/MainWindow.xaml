<Window x:Class="AguiGroupChat.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AguiGroupChat.Desktop"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{x:Static local:L10n.Title}"
        Icon="Assets/agui-icon-128.png"
        Height="860" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部状态栏：本地服务地址 + 便捷操作 -->
        <Border Grid.Row="0" Background="#FF1F2937" Padding="10,6">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="StatusText" Foreground="#FF9CA3AF" FontSize="12"
                           VerticalAlignment="Center" Text="{x:Static local:L10n.StatusStarting}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="HomeBtn" Content="{x:Static local:L10n.Home}" Margin="4,0" Padding="10,2"
                            Click="OnHomeClicked" />
                    <Button x:Name="ReloadBtn" Content="{x:Static local:L10n.ForceReload}" Margin="4,0" Padding="10,2"
                            ToolTip="{x:Static local:L10n.ReloadTip}"
                            Click="OnReloadClicked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- WebView2：加载本地群聊前端 -->
        <wv2:WebView2 x:Name="WebView" Grid.Row="1" />
    </Grid>
</Window>
