{
  "Urls": "http://127.0.0.1:5200",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Storage": {
    "Provider": "sqlite",
    "ConnectionString": "Data Source=data/agui.sqlite",
    "AutoCreateSchema": true
  },
  "Agents": {
    "Provider": "deepseek",
    "EnableTools": true,
    "EnableWebTools": false,
    "AllowPrivateSkillEndpoints": true,
    "CoordinatorPlanning": true,
    "Memory": {
      "Enabled": true,
      "Provider": "llama",
      "LlamaModelPath": "models/embedding.gguf",
      "ModelDownloadUrl": "",
      "LlamaContextSize": 2048,
      "LlamaThreads": 4,
      "EmbeddingDimensions": 1024,
      "TopK": 5,
      "MinScore": 0.25,
      "Scope": "agent",
      "PersonalTopK": 3,
      "PersonalMinScore": 0.25,
      "GraphEnabled": false,
      "GraphTopK": 2,
      "GraphMinScore": 0.45,
      "GraphHops": 1
    }
  },
  "GroupChat": {
    "SeedSampleData": true
  }
}
