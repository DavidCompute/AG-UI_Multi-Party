{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "SessionTtlHours": 168,
    "RequireTokenOnRealTime": true
  },
  "Storage": {
    "Provider": "memory",
    "ConnectionString": ""
  },
  "Persistence": {
    "Enabled": true,
    "FilePath": "data/agui-state.json",
    "FlushIntervalSeconds": 5
  },
  "GroupChat": {
    "MessageHistoryLimit": 200,
    "SnapshotMessageCount": 50,
    "MaxGroupMembers": 500,
    "HeartbeatIntervalSeconds": 15,
    "MessageWriteDebounceMs": 1000,
    "SeedSampleData": false
  }
}
